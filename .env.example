# Anthropic API key for live AI letter generation.
# Leave unset to run Aurix in deterministic demo mode (no AI calls, no cost).
# Copy this file to .env.local and set your key to enable full AI generation.
ANTHROPIC_API_KEY=

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# Leave BOTH unset to run in demo mode, where the published sandbox accounts
# apply and no PHI belongs. Set BOTH to switch to real authentication, where
# credentials are verified server-side against scrypt hashes and the session
# travels in an httpOnly signed cookie.
#
# Generate an entry with:   npm run hash-password -- --email you@practice.com
#
# IMPORTANT: use SINGLE quotes. The hash format separates its fields with "$",
# and a shell will expand those inside double quotes and silently corrupt the
# hash. Aurix detects that specific corruption and says so, but single quotes
# avoid it entirely.
#
# AURIX_USERS='[{"email":"dr.patel@practice.com","name":"Dr A Patel","role":"clinician","hash":"scrypt$32768$8$1$...$..."}]'
AURIX_USERS=

# At least 32 characters. Generate with:  openssl rand -base64 48
# Changing it invalidates every existing session, which is how you force a
# sign-out everywhere.
AURIX_SESSION_SECRET=
